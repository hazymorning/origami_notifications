{
  "name": "origami-notifications",
  "version": "1.3.1",
  "private": true,
  "description": "A notification card for Home Assistant",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.js --bundle --minify --format=esm --target=es2022 --legal-comments=eof --outfile=dist/origami-notifications.js",
