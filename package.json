    "lint": "eslint . && python3 scripts/text-style.py"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "jsdom": "^29.1.1"
  }
}
